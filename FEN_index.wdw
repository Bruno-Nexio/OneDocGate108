       name : BTN_TestConnection
       identifier : 0x2aaba7af01a7f0b2
       internal_properties : 
       properties :
        x : 202
        y : 162
        width : 80
        height : 24
        accelerator_key : 65535
        tab_order : 3
       style : {}
       type : 4
       code_elements :
        type_code : 4
        p_codes :
         -
           code : |1-
            // =========================================================
            // TEST CONNEXION NEXAPI
            // =========================================================
            
            // ---------------------------------------------------------
            // 1. Vérification des champs
            // ---------------------------------------------------------
            
            SI SAI_URI = "" ALORS
            	Erreur("Veuillez saisir l'URI de NEXAPI.")
            	RepriseSaisie(SAI_URI)
            	RETOUR
            FIN
            
            SI SAI_Username = "" ALORS
            	Erreur("Veuillez saisir le nom d'utilisateur.")
            	RepriseSaisie(SAI_Username)
            	RETOUR
            FIN
            
            SI SAI_Password = "" ALORS
            	Erreur("Veuillez saisir le mot de passe.")
            	RepriseSaisie(SAI_Password)
            	RETOUR
            FIN
            
            
            // ---------------------------------------------------------
            // 2. Construction du Basic Auth
            // ---------------------------------------------------------
            
            sUserPassword	est une chaîne	= SAI_Username + ":" + SAI_Password
            
            bufAuth			est un Buffer	= ChaîneVersUTF8(sUserPassword)
            
            sBase64			est une chaîne	= Encode(bufAuth, encodeBASE64)
            
            // Encode() peut ajouter un CR
            sBase64 = Remplace(sBase64, CR, "")
            
            sAuthorization	est une chaîne	= "Basic " + sBase64
            
            
            // ---------------------------------------------------------
            // 3. Construction de l'URL
            // ---------------------------------------------------------
            
            sURI			est une chaîne	= SAI_URI
            
            // Supprime le "/" final éventuel
            SI Droite(sURI, 1) = "/" ALORS
            	sURI = Gauche(sURI, Taille(sURI) - 1)
            FIN
            
            sURL	est une chaîne	= sURI + "/auth/check"
            
            
            // ---------------------------------------------------------
            // 4. Construction de la requête HTTP
            // ---------------------------------------------------------
            
            reqTest	est une httpRequête
            repTest	est une httpRéponse
            
            reqTest..URL						= sURL
            reqTest..Méthode					= httpGet
            
            reqTest..Entête["Authorization"]	= sAuthorization
            reqTest..Entête["Accept"]			= "application/json"
            
            
            // ---------------------------------------------------------
            // 5. Envoi de la requête
            // ---------------------------------------------------------
            
            repTest								= HTTPSend(reqTest)
            
            SI ErreurDétectée ALORS
            
            	ToastAffiche(...
            	"Impossible de contacter NEXAPI." + RC + RC + ...
            	"URL : " + sURL + RC + RC + ...
            	ErreurInfo(errComplet))
            
            	RETOUR
            
            FIN
            
            
            // ---------------------------------------------------------
            // 6. Analyse de la réponse
            // ---------------------------------------------------------
            
            // ---------------------------------------------------------
            // Résultat
            // ---------------------------------------------------------
            
            // ---------------------------------------------------------
            // Result
            // ---------------------------------------------------------
            
            SWITCH repTest..StatusCode
            
            	CASE 200
            
            		// Read JSON response
            		jsResponse is JSON = StringToJSON(repTest..Content)
            
            		IF jsResponse.authenticated = True THEN
            
            			ToastAffiche(...
            			"NEXAPI connection successful." + CR + CR + ...
            			"Authentication valid." + CR + ...
            			"Username: " + jsResponse.username)
            
            		ELSE
            
            			ToastAffiche(...
            			"The server returned HTTP 200," + CR + ...
            			"but authentication is not valid.")
            
            		END
            
            
            	CASE 401
            
            		// Read server error message
            		jsError is JSON = StringToJSON(repTest..Content)
            
            		ToastAffiche(...
            		"NEXAPI authentication failed." + CR + CR + ...
            		"Please check the username and password." + CR + CR + ...
            		"Server: " + jsError.message)
            
            
            	OTHER CASE
            
            		ToastAffiche(...
            		"An error occurred while testing NEXAPI." + CR + CR + ...
            		"HTTP: " + repTest..StatusCode + CR + ...
            		"Response: " + repTest..Content)
            
            END
           type : 18
         -
           type : 161
           enabled : false
