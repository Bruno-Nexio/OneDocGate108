       name : BTN_SaveDatabase
       identifier : 0x2aabe565049cfe0c
       internal_properties : 
       properties :
        x : 374
        y : 196
        width : 80
        height : 24
        accelerator_key : 65535
        tab_order : 5
       style : {}
       type : 4
       code_elements :
        type_code : 4
        p_codes :
         -
           code : |1+
            // =========================================================
            // SAVE DATABASE SETTINGS
            // =========================================================
            
            sINIFile is string = fCurrentDir() + "\settings.ini"
            
            
            // ---------------------------------------------------------
            // 1. Check fields
            // ---------------------------------------------------------
            
            IF NoSpace(SAI_DB_Server) = "" THEN
            	Error("The database server is required.")
            	ReturnToCapture(SAI_DB_Server)
            	RETURN
            END
            
            IF NoSpace(SAI_DB_Database) = "" THEN
            	Error("The database name is required.")
            	ReturnToCapture(SAI_DB_Database)
            	RETURN
            END
            
            IF NoSpace(SAI_DB_Login) = "" THEN
            	Error("The database username is required.")
            	ReturnToCapture(SAI_DB_Login)
            	RETURN
            END
            
            //IF SAI_DB_Password = "" THEN
            //	Error("The database password is required.")
            //	ReturnToCapture(SAI_DB_Password)
            //	RETURN
            //END
            
            
            // ---------------------------------------------------------
            // 2. Save settings.ini
            // ---------------------------------------------------------
            
            INIWrite("DATABASE", "SERVER", SAI_DB_Server, sINIFile)
            INIWrite("DATABASE", "BDD", SAI_DB_Database, sINIFile)
            INIWrite("DATABASE", "LOGIN", SAI_DB_Login, sINIFile)
            INIWrite("DATABASE", "PASSWORD",SAI_DB_Password, sINIFile)
            
            
            // ---------------------------------------------------------
            // 3. Update current connection
            // ---------------------------------------------------------
            
            gMyConnect..User		= SAI_DB_Login
            gMyConnect..Password	= SAI_DB_Password
            gMyConnect..Server		= SAI_DB_Server
            gMyConnect..Database	= SAI_DB_Database
            
            HChangeConnection("*", gMyConnect)
            
            
            // ---------------------------------------------------------
            // 4. Restore file directories
            // ---------------------------------------------------------
            
            HChangeRep(FIC_ADM, "Commun")
            HChangeRep(Int_Doctolib, "Commun")
            HChangeRep(ASSURCH, "Commun")
            
            
            // ---------------------------------------------------------
            // 5. Confirmation
            // ---------------------------------------------------------
            
            ToastAffiche("Database settings saved successfully.")
