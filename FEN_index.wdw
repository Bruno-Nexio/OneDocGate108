       name : BTN_Save
       identifier : 0x2aab927b19bc1ad3
       internal_properties : 
       properties :
        x : 374
        y : 162
        width : 80
        height : 24
        accelerator_key : 65535
        tab_order : 5
       style : {}
       type : 4
       code_elements :
        type_code : 4
        p_codes :
         -
           code : |1+
            sFichierINI est une chaîne = fRepExe() + ["\"] + "settings.ini"
            
            // URI
            INIEcrit("nexapi", "URI", SAI_URI, sFichierINI)
            
            // Création username:password
            sUserPassword	est une chaîne	= SAI_Username + ":" + SAI_Password
            
            bufAuth	est un Buffer	= ChaîneVersUTF8(sUserPassword)
            sBase64	est une chaîne	= Encode(bufAuth, encodeBASE64)
            
            // Encode peut ajouter des retours à la ligne
            sBase64	= Remplace(sBase64, CR, "")
            
            // Authorization HTTP Basic
            sAuthorization	est une chaîne	= sBase64
            
            INIEcrit("nexapi", "AUTHORIZATION", sAuthorization, sFichierINI)
            
            ToastAffiche("Configuration saved successfully")
           type : 18
         -
           type : 161
           enabled : false
     -
