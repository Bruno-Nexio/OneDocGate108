            	SELECT COUNT(FICLEUNIK) AS NbEnregistrements<§cs:3§>
            	FROM FIC_ADM<§cs:3§>
            ]
            
            IF HExecuteQuery(MyQuery) = False THEN
            	Error("Erreur d'initialisation de la requête" + CR + HErrorInfo())
            	RETURN
            END
            
            HReadFirst(MyQuery)
            
            IF NOT HOut(MyQuery) THEN
            	Trace(MyQuery.NbEnregistrements)
            END
