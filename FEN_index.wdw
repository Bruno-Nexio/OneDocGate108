     name : clickChanges
     internal_properties : HgAAAB4AAABtQkFJxed+U1iZwogzNUw8n9MT8bRz/8JfQU9uKqokXfZ6hji+RESRT0hctaj7Ps+mbvJKYO1vL2OM4BjBy5UJHOW+8mJbxOAqg4OirDTYrcfu5HEt8Qjwj2c=
     procedure_id : 1742287598670413436
     type_code : 14
     code : |1+
      // Procédure automatique :
      // La procédure est exécutée automatiquement, après le code d'initialisation de la fenêtre, avec un différé de 15 secondes
      // Elle sera répétée en boucle, en attendant 15 secondes entre chaque appel
      // Chaque appel suivant exécute une seule fois la procédure, sans timer
      //
      
      procédure clickChanges()
      	ExécuteTraitement(BTN_changes,trtClic)
     type : 458752
   -
     name : ChargeSettings
     procedure_id : 1921798986521409873
     type_code : 14
     code : |1+
      PROCÉDURE ChargeSettings()
      
      sFichierINI est une chaîne = fRepExe() + ["\"] + "settings.ini"
      
      // URI
      SAI_URI = INILit("nexapi", "URI", "", sFichierINI)
      guri = SAI_URI
      
      // Authorization
      sAuthorization est une chaîne = INILit("nexapi", "AUTHORIZATION", "", sFichierINI)
      gauthorization = sAuthorization
      
      SAI_Username	= ""
      SAI_Password	= ""
      
      SI sAuthorization <> "" ALORS
      
      	// Retire "Basic " si présent
      	SI Gauche(sAuthorization, 6) = "Basic " ALORS
      		sAuthorization = Milieu(sAuthorization, 7)
      	FIN
      
      	// Décodage Base64
      	bufAuth			est un Buffer	= Décode(sAuthorization, encodeBASE64)
      	sUserPassword	est une chaîne	= UTF8VersChaîne(bufAuth)
      
      	// Séparation username:password
      	nPos			est un entier	= Position(sUserPassword, ":")
      
      	SI nPos > 0 ALORS
      		SAI_Username	= Gauche(sUserPassword, nPos - 1)
      		SAI_Password	= Milieu(sUserPassword, nPos + 1)
      	SINON
      		SAI_Username = sUserPassword
      	FIN
      
      FIN
      
      // =========================================================
      // DATABASE
      // =========================================================
      
      SAI_DB_Server	= INIRead("DATABASE", "SERVER", "", sFichierINI)
      SAI_DB_Database	= INIRead("DATABASE", "BDD", "", sFichierINI)
      SAI_DB_Login	= INIRead("DATABASE", "LOGIN", "", sFichierINI)
      SAI_DB_Password	= INIRead("DATABASE", "PASSWORD", "", sFichierINI)
     type : 458752
   -
     name : TestDatabaseConnection
     procedure_id : 1921882287391664499
     type_code : 14
     code : |1+
      PROCEDURE TestDatabaseConnection()
      
      // =========================================================
      // 1. Check fields
      // =========================================================
      
      IF NoSpace(SAI_DB_Server) = "" THEN
      	Error("The database server is required.")
      	ReturnToCapture(SAI_DB_Server)
      	RETURN
      END
      
      IF NoSpace(SAI_DB_Database) = "" THEN
      	Error("The database name is required.")
      	ReturnToCapture(SAI_DB_Database)
      	RETURN
      END
      
      IF NoSpace(SAI_DB_Login) = "" THEN
      	Error("The database username is required.")
      	ReturnToCapture(SAI_DB_Login)
      	RETURN
      END
      
      //IF SAI_DB_Password = "" THEN
      //	Error("The database password is required.")
      //	ReturnToCapture(SAI_DB_Password)
      //	RETURN
      //END
      
      
      // =========================================================
      // 2. Temporary connection
      // =========================================================
      
      cnxTest is Connection
      
      cnxTest..User			= SAI_DB_Login
      cnxTest..Password		= SAI_DB_Password
      cnxTest..Server			= SAI_DB_Server
      cnxTest..Database		= ""
      cnxTest..Provider		= hAccessHFClientServer
      cnxTest..Access			= hOReadWrite
      cnxTest..ExtendedInfo	= "Infos étendues"
      cnxTest..CursorOptions	= hClientCursor
      cnxTest..Compression	= False
      
      
      // =========================================================
      // 3. Connect to HFSQL server
      // =========================================================
      
      IF NOT HOpenConnection(cnxTest) THEN
      
      	ToastAffiche(...
      	"Unable to connect to the HFSQL server." + CR + CR + ...
      	"Server: " + SAI_DB_Server + CR + ...
      	"Username: " + SAI_DB_Login + CR + CR + ...
      	"Technical details:" + CR + ...
      	HErrorInfo())
      
      	RETURN
      
      END
      
      
      // =========================================================
      // 4. Get database list
      // =========================================================
      
      sListDatabase is string = HListDatabase(cnxTest, hLstNormal)
      
      IF ErrorOccurred THEN
      
      	sError is string = HErrorInfo()
      
      	HCloseConnection(cnxTest)
      
      	ToastAffiche(...
      	"Unable to retrieve the database list." + CR + CR + ...
      	"Server: " + SAI_DB_Server + CR + CR + ...
      	"Technical details:" + CR + ...
      	sError)
      
      	RETURN
      
      END
      
      // =========================================================
      // 5. Search requested database
      // =========================================================
      
      bFound		is boolean	= False
      sDatabase	is string
      
      FOR EACH STRING sDatabase OF sListDatabase SEPARATED BY TAB
      
      	IF Upper(NoSpace(sDatabase)) = Upper(NoSpace(SAI_DB_Database)) THEN
      		bFound = True
      		BREAK
      	END
      
      END
      
      
      // =========================================================
      // 6. Database not found
      // =========================================================
      
      IF NOT bFound THEN
      
      	HCloseConnection(cnxTest)
      
      	ToastAffiche(...
      	"HFSQL server connection successful," + CR + ...
      	"but the database was not found." + CR + CR + ...
      	"Server: " + SAI_DB_Server + CR + ...
      	"Database: " + SAI_DB_Database)
      
      	RETURN
      
      END
      
      
      // =========================================================
      // 7. Success
      // =========================================================
      
      HCloseConnection(cnxTest)
      
      ToastAffiche(...
      "Database connection successful." + CR + CR + ...
      "Server: " + SAI_DB_Server + CR + ...
      "Database: " + SAI_DB_Database + CR + ...
      "Username: " + SAI_DB_Login)
      
     type : 458752
   -
     name : LitChangeId
     procedure_id : 1933294805770577691
     type_code : 14
     code : |1+
      PROCÉDURE LitChangeId() : entier sur 8 octets
      
      	Trace("Hello")
      
      	SI PAS fRépertoireExiste(gsRepEtatOneDoc) ALORS
      		fRepCrée(gsRepEtatOneDoc)
      	FIN
      
      	SI PAS fFichierExiste(gsFichierChangeId) ALORS
      		RENVOYER 0
      	FIN
      
      	sChangeId est une chaîne = SansEspace(fChargeTexte(gsFichierChangeId))
      
      	SI sChangeId = "" ALORS
      		RENVOYER 0
      	FIN
      
      RENVOYER Val(sChangeId)
      
     type : 458752
   -
     name : SauveChangeId
     procedure_id : 1933294968979504465
     type_code : 14
     code : |1+
      PROCÉDURE SauveChangeId(nChangeId est un entier sur 8 octets) : booléen
      
      SI PAS fRépertoireExiste(gsRepEtatOneDoc) ALORS
      	SI PAS fRepCrée(gsRepEtatOneDoc) ALORS
      		RENVOYER Faux
      	FIN
      FIN
      
      RENVOYER fSauveTexte(gsFichierChangeId, nChangeId)
      
     type : 458752
